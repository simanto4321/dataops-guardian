# Copy to .env and adjust. All variables are prefixed with DATAOPS_.

# Control-plane metadata store. Defaults to zero-setup SQLite.
# PostgreSQL (recommended for production, used by docker-compose):
#   DATAOPS_DATABASE_URL=postgresql+psycopg://dataops:dataops@localhost:5432/dataops
DATAOPS_DATABASE_URL=sqlite:///./dataops.db

# Observed warehouse. Leave blank to reuse DATABASE_URL (single-DB demo),
# or point at a separate analytics warehouse.
# DATAOPS_WAREHOUSE_URL=postgresql+psycopg://readonly:readonly@warehouse:5432/analytics

# Comma-separated allowed CORS origins for the web dashboard.
DATAOPS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
